model repository{
    id String @id  @default(uuid())
    name String
    url String
    owner String
    path String
}
model embedding{
  ansid String @id @default(uuid())
  chat String 
  ans UserQuery[]
}
model UserQuery{
  id String @id @default(uuid())
  query String
  ans embedding @relation(fields: [id],references: [ansid])
}