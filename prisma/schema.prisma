 generator client {
    provider = "prisma-client"
    output = "../generated/prisma" 
    previewFeatures = ["postgresqlExtensions"]
  }
  datasource db {
    provider = "postgresql"
    extensions = [vector]
  }
//   model User{
//     id String @id @default(uuid())
//     email String @unique
//     password String
//     createdAt DateTime @default(now())
//     updatedAt DateTime @updatedAt
//   }
model repository{
    id Int @id @default(autoincrement()) @unique
    name String
    url String
    owner String
    path String
    files files[]
   
}
model files{
  id Int @id @default(autoincrement()) 
  fileName String
  fileContent String
  repository repository @relation(fields: [repositoryId],references: [id])
  repositoryId Int
  chunk chunk[]
}
model chunk{
  chunkId Int @id @default(autoincrement()) 
  data String
  position Int
  files files @relation(fields: [filesId],references:[id])
  filesId Int
  embedding embedding?
}
model embedding{
  embeddingId Int @id @default(autoincrement()) 
  data Unsupported("vector(768)")
  chunk chunk @relation(fields: [chunkId],references:[chunkId])
  chunkId Int

}
model UserQuery{
  id String @id @default(uuid())
  query String

}